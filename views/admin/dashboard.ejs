<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Hotspot Portal</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #1a1a2e; color: #fff; padding: 25px; margin: 0; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
        .header h1 { margin: 0; font-size: 26px; }
        .header a { color: #ff6b6b; text-decoration: none; border: 1px solid rgba(255,255,255,0.2); padding: 8px 16px; border-radius: 8px; font-size: 14px; }
        
        .stats { display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; }
        .stat-card {
            background: rgba(255,255,255,0.08); padding: 22px; border-radius: 14px;
            flex: 1; min-width: 180px; text-align: center; border: 1px solid rgba(255,255,255,0.1);
        }
        .stat-card h3 { font-size: 36px; color: #00d4ff; margin: 0; }
        .stat-card p { color: rgba(255,255,255,0.6); margin: 6px 0 0; font-size: 14px; }
        
        .section-box {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
        }
        .section-title { margin-top: 0; margin-bottom: 15px; font-size: 20px; display: flex; justify-content: space-between; align-items: center; }

        table { width: 100%; border-collapse: collapse; border-radius: 8px; overflow: hidden; }
        th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.08); font-size: 14px; }
        th { background: rgba(0,212,255,0.15); color: #00d4ff; font-weight: 600; }
        tr:hover td { background: rgba(255,255,255,0.02); }

        .active-badge { background: #34c759; color: #fff; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
        .inactive-badge { background: #ff3b30; color: #fff; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }

        .btn-sm { padding: 6px 14px; border: none; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600; transition: opacity 0.2s; }
        .btn-danger { background: #ff3b30; color: #fff; }
        .btn-success { background: #34c759; color: #fff; }
        .btn-primary { background: #00d4ff; color: #000; padding: 8px 16px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }

        .voucher-form { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 15px; }
        .voucher-form input, .voucher-form select {
            padding: 8px 12px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2);
            color: #fff; border-radius: 8px; font-size: 14px;
        }
        .code-chip {
            background: rgba(0, 212, 255, 0.15);
            color: #00d4ff;
            padding: 4px 8px;
            border-radius: 4px;
            font-family: monospace;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>📡 Hotspot Admin Dashboard</h1>
        <a href="/admin/logout">Sign Out</a>
    </div>

    <!-- Stats Row -->
    <div class="stats">
        <div class="stat-card">
            <h3><%= stats.total_users %></h3>
            <p>Total Users</p>
        </div>
        <div class="stat-card">
            <h3><%= stats.active_sessions %></h3>
            <p>Active WiFi Sessions</p>
        </div>
        <div class="stat-card">
            <h3><%= stats.new_today %></h3>
            <p>Registered Today</p>
        </div>
    </div>

    <!-- Voucher Generator Section -->
    <div class="section-box">
        <div class="section-title">
            <span>🎟️ Voucher Management</span>
        </div>
        <form class="voucher-form" method="POST" action="/admin/generate-voucher">
            <label>Duration (minutes):</label>
            <input type="number" name="duration" value="60" min="5" max="10080" required>
            <label>Count:</label>
            <input type="number" name="count" value="5" min="1" max="50" required>
            <button type="submit" class="btn-primary">+ Generate Vouchers</button>
        </form>

        <% if (vouchers && vouchers.length > 0) { %>
            <table>
                <tr>
                    <th>Code</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Used At</th>
                </tr>
                <% vouchers.slice(0, 10).forEach(v => { %>
                <tr>
                    <td><span class="code-chip"><%= v.code %></span></td>
                    <td><%= v.duration_minutes %> mins</td>
                    <td>
                        <% if (v.is_used) { %>
                            <span class="inactive-badge">Used</span>
                        <% } else { %>
                            <span class="active-badge">Available</span>
                        <% } %>
                    </td>
                    <td><%= new Date(v.created_at).toLocaleString() %></td>
                    <td><%= v.used_at ? new Date(v.used_at).toLocaleString() : '-' %></td>
                </tr>
                <% }) %>
            </table>
        <% } %>
    </div>

    <!-- Active Sessions Table -->
    <div class="section-box">
        <div class="section-title">
            <span>🟢 Active Hotspot Sessions</span>
        </div>
        <% if (activeSessions && activeSessions.length > 0) { %>
            <table>
                <tr>
                    <th>User</th>
                    <th>IP Address</th>
                    <th>MAC Address</th>
                    <th>Connected Since</th>
                </tr>
                <% activeSessions.forEach(s => { %>
                <tr>
                    <td><strong><%= s.username %></strong></td>
                    <td><%= s.ip_address %></td>
                    <td><%= s.mac_address %></td>
                    <td><%= new Date(s.login_time).toLocaleString() %></td>
                </tr>
                <% }) %>
            </table>
        <% } else { %>
            <p style="color: rgba(255,255,255,0.5); margin: 0;">No active client sessions connected at the moment.</p>
        <% } %>
    </div>

    <!-- Users Table -->
    <div class="section-box">
        <div class="section-title">
            <span>👥 Registered Users</span>
        </div>
        <% if (users && users.length > 0) { %>
            <table>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th>Action</th>
                </tr>
                <% users.forEach(u => { %>
                <tr>
                    <td><%= u.id %></td>
                    <td><%= u.username %></td>
                    <td><%= u.email %></td>
                    <td><%= u.phone || '-' %></td>
                    <td>
                        <% if (u.is_active) { %>
                            <span class="active-badge">Active</span>
                        <% } else { %>
                            <span class="inactive-badge">Blocked</span>
                        <% } %>
                    </td>
                    <td><%= new Date(u.created_at).toLocaleDateString() %></td>
                    <td>
                        <form method="POST" action="/admin/toggle-user/<%= u.id %>" style="display:inline">
                            <button type="submit" class="btn-sm <%= u.is_active ? 'btn-danger' : 'btn-success' %>">
                                <%= u.is_active ? 'Block' : 'Unblock' %>
                            </button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </table>
        <% } else { %>
            <p style="color: rgba(255,255,255,0.5); margin: 0;">No users registered yet.</p>
        <% } %>
    </div>
</body>
</html>
