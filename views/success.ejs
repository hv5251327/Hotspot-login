<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connected to WiFi</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            min-height: 100vh;
            display: flex; justify-content: center; align-items: center;
            color: #fff;
            padding: 20px;
        }
        .container { 
            text-align: center;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 40px;
            max-width: 440px;
            width: 90%;
            box-shadow: 0 25px 50px rgba(0,0,0,0.4);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        .checkmark { font-size: 70px; margin-bottom: 15px; }
        h1 { font-size: 28px; margin-bottom: 10px; }
        p { color: rgba(255,255,255,0.7); margin-bottom: 20px; font-size: 15px; }
        .timer { font-size: 44px; color: #00d4ff; margin: 15px 0; font-weight: 300; letter-spacing: 2px; }
        .session-info {
            background: rgba(0,0,0,0.2);
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 25px;
            font-size: 13px;
            color: rgba(255,255,255,0.6);
        }
        .btn {
            display: inline-block;
            padding: 12px 30px; 
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 10px; 
            background: rgba(255,255,255,0.1);
            color: #fff; 
            font-size: 14px; 
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s;
        }
        .btn:hover {
            background: rgba(255, 59, 48, 0.3);
            border-color: #ff3b30;
            color: #ff8080;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="checkmark">✅</div>
        <h1>You're Connected!</h1>
        <p>Welcome, <strong><%= username || 'Guest' %></strong>. Your high-speed internet access is active.</p>
        
        <div class="session-info">
            <div class="timer" id="timer">00:00:00</div>
            <div>Active Session Time</div>
        </div>

        <a href="/logout" class="btn">Disconnect Session</a>
    </div>

    <script>
        let seconds = 0;
        setInterval(() => {
            seconds++;
            const h = Math.floor(seconds / 3600).toString().padStart(2, '0');
            const m = Math.floor((seconds % 3600) / 60).toString().padStart(2, '0');
            const s = (seconds % 60).toString().padStart(2, '0');
            document.getElementById('timer').textContent = `${h}:${m}:${s}`;
        }, 1000);
    </script>
</body>
</html>
